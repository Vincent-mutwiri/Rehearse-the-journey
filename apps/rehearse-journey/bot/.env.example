# Pipecat bot environment — Rehearse the Journey
# Copy this to .env and fill in your keys.

# ── Primary path: OpenAI STT + LLM + TTS (key already set in hub env) ──────
OPENAI_API_KEY=

# ── Optional: Gemini Live speech-to-speech ───────────────────────────────────
# Set GOOGLE_API_KEY to the hub GEMINI_API_KEY value, then set USE_GEMINI_LIVE=1
# to switch the bot to Gemini Multimodal Live instead of OpenAI.
# Requires a Gemini Live / Multimodal Live-eligible model (gemini-2.0-flash-live-001).
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alias — bot reads either variable
USE_GEMINI_LIVE=0

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
