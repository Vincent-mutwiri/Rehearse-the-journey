# Pipecat bot environment — Rehearse the Journey
# Copy this to .env and fill in your keys.

# ── Primary path: OpenAI STT + LLM + TTS (key already set in hub env) ──────
OPENAI_API_KEY=

# ── Optional: Gemini Live speech-to-speech ───────────────────────────────────
# Set GOOGLE_API_KEY to the hub GEMINI_API_KEY value, then set USE_GEMINI_LIVE=1
# to switch the bot to Gemini Multimodal Live instead of OpenAI.
# Requires a Gemini Live / Multimodal Live-eligible model (gemini-2.0-flash-live-001).
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alias — bot reads either variable
USE_GEMINI_LIVE=0

# Optional local Kenyan-English Whisper STT. Keep Gemini Live off when using
# this: Gemini Live performs its own speech recognition and bypasses local STT.
USE_LOCAL_WHISPER=0
LOCAL_WHISPER_MODEL_DIR=D:\\AI-Models\\Whisper-Large-V3-Kenyan

# ── Lovable team Gemini proxy (optional) ────────────────────────────────────
# Route the google-genai Client through the team proxy. The proxy sends the
# key in the x-goog-api-key header (which the Client does for api_key) and
# uses the v1beta API version. Live needs a WebSocket-capable proxy; if the
# proxy only does REST, Live fails and the bot falls back to OpenAI text.
GEMINI_PROXY_BASE_URL=
# GEMINI_PROXY_API_VERSION=v1beta

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
